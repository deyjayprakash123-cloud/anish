# Google Gemini API Keys for Dual-Key Rate Limit Control
# Obtain keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_failover_gemini_api_key_here

# Gemini Model Selection (Lightweight vision models)
# Default is gemini-2.5-flash with automatic fallback to gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
